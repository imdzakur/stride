# Copy to .env.local on the laptop. On Vercel, set these under Project Settings > Environment Variables.
# This file only holds variable names and non-secret example values.

# Single sign-in username. Any value you choose.
APP_USERNAME=

# scrypt hash of the password. Create it with: corepack pnpm hash-password
# The script asks for the password without echoing it and prints scrypt:N:r:p:salt:hash.
APP_PASSWORD_HASH=

# Origin of the running app, without a trailing slash.
# Laptop: http://localhost:3000. Vercel: the deployment URL for that environment.
APP_URL=http://localhost:3000

# At least 32 random bytes in base64. Generate a separate value for each variable:
# node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
SESSION_SECRET=
RATE_LIMIT_SECRET=

# Project URL from Supabase Settings > API. Confirm it against the dashboard before use.
SUPABASE_URL=https://cbpsuhsuvnirlnqmatsc.supabase.co

# New secret key from Supabase Settings > API Keys. Server only; never add a NEXT_PUBLIC_ prefix.
SUPABASE_SECRET_KEY=
